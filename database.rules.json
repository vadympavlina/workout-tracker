{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "data": {
          "user": { ".validate": "newData.hasChildren()" },
          "settings": { ".validate": "newData.hasChildren()" },
          "plans": { "$id": { ".validate": "newData.child('id').val() === $id" } },
          "exercises": { "$id": { ".validate": "newData.child('id').val() === $id" } },
          "sessions": { "$id": { ".validate": "newData.child('id').val() === $id && newData.child('startedAt').isString()" } },
          "bodyWeight": { "$id": { ".validate": "newData.child('id').val() === $id && newData.child('weight').isNumber()" } },
          "$other": { ".validate": false }
        },
        "active": { ".validate": "newData.hasChildren()" },
        "media": {
          "$id": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 400000" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
